DATABASE_URL="postgresql://tino:tino_dev_password@localhost:5432/tino_db?schema=public"
JWT_SECRET="troque-por-uma-string-aleatoria-longa"
JWT_EXPIRES_IN="7d"
PORT=3333

# "manual" até um gateway real (Mercado Pago/Stripe) ser escolhido e plugado
PAYMENT_PROVIDER="manual"
# "console" loga em vez de enviar até um provedor transacional ser configurado
EMAIL_PROVIDER="console"
# Único e-mail autorizado a conceder plano manualmente (PUT /billing/admin/grant)
# e a disparar o digest de todo mundo (POST /notifications/digest/all)
ADMIN_EMAIL="voce@exemplo.com"

# development | production — em production, o boot falha se JWT_SECRET ainda
# for o valor de exemplo acima
NODE_ENV="development"
# Domínios do frontend liberados no CORS, separados por vírgula. Em produção,
# defina como "https://app.seudominio.com" — sem isso, só localhost funciona.
FRONTEND_URL="http://localhost:5173"
# DSN do Sentry (backend). Ausente = rastreio de erro desligado, sem quebrar nada.
SENTRY_DSN=
