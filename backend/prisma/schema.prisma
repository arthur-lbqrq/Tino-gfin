generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Verificação de e-mail e recuperação de senha: nunca guardamos o token puro,
  // só o hash sha256 — o valor puro só existe no link enviado por e-mail e no
  // request de confirmação, nunca em repouso no banco.
  emailVerified               Boolean   @default(false)
  verificationTokenHash       String?
  verificationTokenExpiresAt  DateTime?
  resetTokenHash              String?
  resetTokenExpiresAt         DateTime?

  // Configuração do módulo fiscal MEI — opcional, só relevante pra quem ativa a
  // seção. dasMonthlyAmount fica a cargo do usuário informar (o valor da guia
  // varia por atividade e muda todo ano); meiRevenueLimit tem um teto padrão no
  // código, mas fica editável aqui pra sobreviver a mudanças de lei sem deploy.
  dasMonthlyAmount Decimal? @db.Decimal(10, 2)
  meiRevenueLimit  Decimal? @db.Decimal(12, 2)

  // Plano de assinatura. paymentProvider fica null enquanto o plano foi
  // concedido manualmente (fundador liberando early adopter) em vez de vir de
  // um pagamento real — os adaptadores reais (Mercado Pago/Stripe) preenchem
  // esses três campos quando plugados.
  plan                  Plan       @default(FREE)
  planStatus            PlanStatus @default(ACTIVE)
  planRenewsAt          DateTime?
  paymentProvider       String?
  paymentCustomerId     String?
  paymentSubscriptionId String?

  insightNotifications InsightNotification[]

  categories             Category[]
  transactions           Transaction[]
  accounts               Account[]
  recurringTransactions  RecurringTransaction[]
  budgets                Budget[]
  goals                  Goal[]
  importBatches          ImportBatch[]

  @@map("users")
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum PlanStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum TransactionType {
  RECEITA
  DESPESA
}

// Categoria "padrão" tem userId nulo e fica visível pra todo mundo.
// Categoria criada/editada por um usuário tem userId preenchido e só ele vê.
model Category {
  id        String           @id @default(uuid())
  name      String
  type      TransactionType
  isDefault Boolean          @default(false)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  transactions            Transaction[]
  recurringTransactions   RecurringTransaction[]
  budgets                 Budget[]

  @@unique([userId, name, type])
  @@map("categories")
}

enum AccountType {
  CORRENTE
  CARTEIRA
  CARTAO_CREDITO
  POUPANCA
}

// Conta ou carteira do usuário. Toda transação (exceto legado antigo)
// deve pertencer a uma account, pra dar saldo por conta e permitir
// separar "dinheiro físico" de "conta corrente" de "cartão de crédito".
model Account {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(12, 2)

  // Só usados quando type = CARTAO_CREDITO
  creditLimit    Decimal?    @db.Decimal(12, 2)
  closingDay     Int?        // dia de fechamento da fatura (1-31)
  dueDay         Int?        // dia de vencimento da fatura (1-31)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions   Transaction[]
  invoices       Invoice[]
  recurringTransactions RecurringTransaction[]
  goals          Goal[]
  importBatches  ImportBatch[]

  @@map("accounts")
}

// Fatura de cartão de crédito. Agrupa as transações de um período
// pra separar "quando a despesa aconteceu" de "quando ela pesa no caixa".
model Invoice {
  id             String   @id @default(uuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referenceMonth String   // formato "2026-08"
  closingDate    DateTime
  dueDate        DateTime
  paid           Boolean  @default(false)
  createdAt      DateTime @default(now())

  transactions   Transaction[]

  @@unique([accountId, referenceMonth])
  @@map("invoices")
}

// Modelo (template) de uma transação recorrente. O gerador (job/cron)
// cria Transaction reais a partir daqui, marcando recurringId.
model RecurringTransaction {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  description     String
  amount          Decimal           @db.Decimal(12, 2)
  type            TransactionType
  frequency       RecurrenceFrequency
  startDate       DateTime
  endDate         DateTime?         // null = sem data de término
  lastGeneratedAt DateTime?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())

  generatedTransactions Transaction[]

  @@map("recurring_transactions")
}

enum RecurrenceFrequency {
  DIARIA
  SEMANAL
  MENSAL
  ANUAL
}

// Orçamento por categoria e mês. Alimenta tanto uma tela de "planejado x realizado"
// quanto o motor de insights (ex: "você já usou 90% do orçamento de Alimentação").
model Budget {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  amount         Decimal  @db.Decimal(12, 2)
  referenceMonth String   // formato "2026-08"
  createdAt      DateTime @default(now())

  @@unique([userId, categoryId, referenceMonth])
  @@map("budgets")
}

// Meta de economia vinculada a uma conta (normalmente POUPANCA): o progresso é
// derivado do saldo atual dessa conta, sem precisar de um campo/tabela extra
// de "aportes" — reaproveita o mesmo cálculo de saldo já usado em Account.
model Goal {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  targetDate   DateTime?
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@map("goals")
}

model Transaction {
  id          String           @id @default(uuid())
  type        TransactionType
  amount      Decimal          @db.Decimal(12, 2)
  description String?
  date        DateTime

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  // Preenchido só se a despesa for de cartão de crédito
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])

  // Preenchido se essa transação foi gerada por uma recorrência
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id])

  // Transferência entre contas: duas transações linkadas pelo mesmo par,
  // uma DESPESA na origem e uma RECEITA no destino, marcadas isTransfer = true
  // pra não contarem como receita/despesa "de verdade" nos relatórios.
  isTransfer     Boolean @default(false)
  transferPairId String?

  // Parcelamento de compra no cartão: todas as parcelas de uma mesma compra
  // compartilham installmentGroupId. Cada parcela é uma Transaction própria,
  // com a data da compra original mas ligada à fatura (invoiceId) do mês correspondente.
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?

  importedTransactions ImportedTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([accountId, date])
  @@index([installmentGroupId])
  @@map("transactions")
}

enum ImportFormat {
  OFX
  CSV
}

enum ImportedTransactionStatus {
  PENDENTE
  SUGERIDO
  CONFIRMADO
  IGNORADO
}

// Um upload de extrato (OFX/CSV) vira um "lote" com N linhas parseadas
// (ImportedTransaction). Cada linha é conciliada manualmente: vinculada a uma
// transação já lançada (SUGERIDO -> CONFIRMADO), virar uma transação nova
// (PENDENTE -> CONFIRMADO) ou descartada (IGNORADO).
model ImportBatch {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  fileName  String
  format    ImportFormat
  createdAt DateTime     @default(now())

  items ImportedTransaction[]

  @@map("import_batches")
}

model ImportedTransaction {
  id          String                     @id @default(uuid())
  batchId     String
  batch       ImportBatch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // FITID do OFX (quando existe) — usado pra não reimportar a mesma linha em
  // uploads futuros do mesmo extrato. CSV normalmente não tem um id estável.
  externalId  String?
  date        DateTime
  description String
  amount      Decimal                    @db.Decimal(12, 2)
  type        TransactionType
  status      ImportedTransactionStatus  @default(PENDENTE)

  linkedTransactionId String?
  linkedTransaction   Transaction? @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([batchId])
  @@map("imported_transactions")
}

// Marca quando cada tipo de insight crítico foi notificado por e-mail pra um
// usuário, pra não reenviar o mesmo alerta a cada vez que o digest roda —
// sem isso, um insight que continua verdadeiro (ex: orçamento estourado)
// dispararia um e-mail novo a cada execução do job.
model InsightNotification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  insightType String
  lastSentAt  DateTime @default(now())

  @@unique([userId, insightType])
  @@map("insight_notifications")
}
